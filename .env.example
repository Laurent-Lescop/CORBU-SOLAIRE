# Clé Gemini : uniquement pour le service de diagnostic IA (src/core/AIService.ts).
# Copiez ce fichier en .env.local et renseignez votre clé.
# ATTENTION : une variable VITE_* est incluse dans le code envoyé au navigateur.
# Usage local uniquement ; ne publiez jamais un site construit avec une vraie clé.
VITE_GOOGLE_API_KEY="VOTRE_CLE_ICI"

# Optionnel : modèle Gemini (les modèles changent vite, voir ai.google.dev/gemini-api/docs/models)
# VITE_GEMINI_MODEL="gemini-3.8-flash"
